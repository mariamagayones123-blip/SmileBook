# SmileBook - simple LOCAL setup (SQLite). Copy this file to .env, then run:
#   php artisan key:generate
#   php artisan migrate --seed
# For Supabase/PostgreSQL or a deployed site, use .env.example instead.

APP_NAME=SmileBook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: a single file at backend/database/database.sqlite ---
DB_CONNECTION=sqlite

# --- Accounts created by "php artisan migrate --seed" ---
# LOCAL TESTING ONLY: creates admin@smilebook.test / admin123 and patient@smilebook.test / patient123.
# Never use these on a deployed site (the seeder ignores this setting when APP_ENV=production).
SEED_DEMO_ACCOUNTS=true
# For your own admin account instead: set SEED_DEMO_ACCOUNTS=false and fill these in (password: 8+ characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# --- Email ---
# "log" writes emails (including the password-reset code) to storage/logs/laravel.log. No Gmail needed.
# For real emails, see "Email" in the README.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="smilebook@example.com"
MAIL_FROM_NAME="SmileBook"

# --- Email over HTTPS (only for a deployed site; leave empty locally) ---
MAILRELAY_URL=
MAILRELAY_SECRET=

# --- SMS (turned off: no approved Semaphore sender name) ---
SMS_ENABLED=false
SMS_API_KEY=
SMS_SENDER=

# --- Google / Facebook sign-in (optional, leave blank to skip) ---
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
