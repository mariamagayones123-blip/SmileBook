APP_NAME=SmileBook
# Local: APP_ENV=local + APP_DEBUG=true.  Production (deployed): APP_ENV=production + APP_DEBUG=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

# Frontend website(s) allowed to call this API (comma-separated). Needed when deployed, e.g. https://smilebook.vercel.app
# Not needed on localhost.
CORS_ALLOWED_ORIGINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- First admin account (used once by: php artisan migrate --seed) ---
# Use a Gmail address so "Forgot password" works for you. Delete these two lines from .env afterwards if you like.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Local throw-away testing ONLY (never on Supabase): creates admin@smilebook.test / patient@smilebook.test
# SEED_DEMO_ACCOUNTS=true

# --- Supabase (PostgreSQL) ---
# Connect button in Supabase -> Session pooler
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<your database password>
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email (Gmail SMTP) ---
# Use MAIL_MAILER=log while testing (emails get written to storage/logs/laravel.log).
# For Gmail: turn on 2-Step Verification, then create an App Password (16 characters).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_TIMEOUT=15
MAIL_USERNAME=<your gmail address>
MAIL_PASSWORD=<gmail app password>
MAIL_FROM_ADDRESS="<your gmail address>"
MAIL_FROM_NAME="SmileBook"

# --- SMS (Semaphore - semaphore.co) ---
# Leave SMS_API_KEY blank = SMS messages are only written to storage/logs/laravel.log
# Email over HTTPS (needed on Render's free tier, which blocks SMTP). Leave empty to use MAIL_MAILER instead.
SENDLIBERTY_API_KEY=
SENDLIBERTY_FROM_EMAIL=

SMS_ENABLED=false
SMS_API_KEY=
SMS_SENDER=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sign in with Google / Facebook (optional, see README) ---
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
